{
  "name": "akapen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/cli.ts",
    "build": "bun build src/cli.ts --compile --minify --sourcemap --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile dist/akapen",
    "format": "bun fmt src test",
    "verify": "bun check && bun fmt --check src test && bun test"
  },
  "dependencies": {
    "ignore": "7.0.13",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
